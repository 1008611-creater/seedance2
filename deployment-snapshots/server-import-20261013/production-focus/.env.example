APP_URL=
NEXT_PUBLIC_IMAGE2_SITE_URL=
# 旧域 image2.lsb0713.online / ai.lsb0713.online 的 308 跳转逃生开关：设为 1 可临时关闭跳转排查问题。
IMAGE2_DISABLE_LEGACY_REDIRECT=
ADMIN_TOKEN=
IMAGE2_ENABLE_ADMIN_TOKEN_BREAK_GLASS=
# HttpOnly administrator cookies default to Secure in production and non-Secure
# in local development. Override only for an explicitly controlled test runtime.
IMAGE2_ADMIN_COOKIE_SECURE=
# Commercial runtime safety: keep both flags empty in production.
# They exist only for an explicitly isolated legacy/internal compatibility environment.
IMAGE2_ENABLE_LEGACY_SEEDANCE_API=
IMAGE2_ENABLE_INTERNAL_OPERATIONS_API=
SEEDANCE_SMOKE_BASE_URL=
SEEDANCE_SMOKE_ADMIN_TOKEN=
SEEDANCE_SMOKE_VIDEO_URL=

# Supabase Auth / Postgres
# Use placeholders only. Configure real values in Vercel project settings.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's new dashboard labels this as a publishable key: sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase's new dashboard labels this as a secret key: sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=

# Unified login / human verification
# Create a Cloudflare Turnstile site key + secret for scene.lsb0713.online and image2.cauai.fun.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# In production this should be true or omitted when NODE_ENV=production.
UNIFIED_AUTH_TURNSTILE_REQUIRED=
# Local smoke only. Do not set these in production.
UNIFIED_AUTH_ALLOW_MOCKS=
UNIFIED_AUTH_TURNSTILE_MOCK=
UNIFIED_AUTH_SUPABASE_MOCK=
UNIFIED_AUTH_SMOKE_BASE_URL=
UNIFIED_AUTH_SMOKE_ADMIN_TOKEN=

# Public picture studio username/password account and generation history smoke.
# Do not enable generation mocks in production; they are for local smoke only.
PICTURE_AUTH_REAL_SMOKE_BASE_URL=
PICTURE_AUTH_REAL_SMOKE_HOST=
IMAGE2_GENERATION_ALLOW_MOCKS=
IMAGE2_GENERATION_MOCK=

# Optional migration push credentials. Do not expose these to the browser.
# Preferred: a full Postgres connection string from Supabase Database settings.
SUPABASE_DB_URL=
# Alternative: Supabase CLI access token + database password.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Keep "local" until the Supabase schema and auth flow are live.
# local = .data JSON or Vercel temporary runtime store
# supabase = future production account-backed asset sync
IMAGE2_ASSET_SYNC_BACKEND=

# Image2 case-library gacha run history and saved recipes.
# local = .data JSON store
# supabase = account-backed image2_gacha_runs / image2_gacha_recipes tables
IMAGE2_GACHA_BACKEND=
# Test stage keeps pack mode at two real generated images plus seven locked slots.
IMAGE2_GACHA_PACK_DRAW_COUNT=

# Seedance video studio store.
# Keep "local" until supabase/migrations/202605250002_seedance_guest_store.sql has been applied.
# local = .data JSON or Vercel temporary runtime store
# supabase = seedance_* guest-user tables in Supabase Postgres
SEEDANCE_STORE_BACKEND=
SEEDANCE_SEED_DEMO_CODES=

# Image2 workbench shared team library.
# local = DAIHUO_OUTPUT_ROOT/image2-workbench-library JSON + local files
# supabase = public Storage bucket + image2_workbench_assets / feedback tables
IMAGE2_WORKBENCH_STORAGE_BACKEND=
IMAGE2_WORKBENCH_TEAM_EMAILS=
DAIHUO_OUTPUT_ROOT=

# BytePlus / ModelArk Seedance 2.0
# Leave these empty to use the built-in mock video provider for MVP testing.
VIDEO_PROVIDER=
BYTEPLUS_API_KEY=
SEEDANCE_MODEL_ID=
SEEDANCE_API_BASE=

# Local doubao2api proxy. Set VIDEO_PROVIDER=doubao2api to use this channel.
# The proxy project lives at D:\codex-work\seedance2-video-api and defaults to port 7872.
DOUBAO2API_PROXY_BASE_URL=
# Optional account pool. Use semicolon-separated id=url entries, one upstream service per logged-in browser profile.
# Example: DOUBAO2API_UPSTREAMS=main=http://127.0.0.1:9090/v1;acct-9091=http://127.0.0.1:9091/v1
DOUBAO2API_UPSTREAMS=
DOUBAO2API_API_KEY=
DOUBAO2API_TIMEOUT_MS=
DOUBAO2API_RATE_LIMIT_COOLDOWN_MS=
DOUBAO2API_LOGIN_REQUIRED_COOLDOWN_MS=
DOUBAO2API_MIN_INTERVAL_MS=
DOUBAO2API_QUEUE_TIMEOUT_MS=
DOUBAO2API_VIDEO_MODEL=
DOUBAO2API_AUDIO_MODEL=
