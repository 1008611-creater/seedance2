# Copy to deploy/image2/production.env on the deployment machine.
# Do not commit production.env.

APP_URL=https://picture.lsb0713.online
ADMIN_TOKEN=change-me

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_IMAGE2_LINK_SITE_URL=https://image2.cauai.fun
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile for /login. Keep the secret out of committed files.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional, used only by migration scripts. Do not expose this to the browser.
SUPABASE_DB_URL=
# Optional smoke target for public picture username/password account and history.
PICTURE_AUTH_REAL_SMOKE_BASE_URL=https://picture.lsb0713.online
PICTURE_AUTH_REAL_SMOKE_HOST=picture.lsb0713.online

IMAGE2_ASSET_SYNC_BACKEND=supabase
IMAGE2_GACHA_BACKEND=supabase
IMAGE2_GACHA_PACK_DRAW_COUNT=2
IMAGE2_WORKBENCH_STORAGE_BACKEND=supabase
IMAGE2_WORKBENCH_TEAM_EMAILS=
DAIHUO_OUTPUT_ROOT=/data/daihuo-output

# Preferred Image2 channel: Ikun / Monkey Tools compatible image2.
IKUN_IMAGE2_API_KEY=
IKUN_IMAGE2_BASE_URL=https://api.monkey-tools.cn
IKUN_IMAGE2_MODEL=gpt-image-2

# Optional fallback channel: RunningHub Image2 text-to-image and image-to-image.
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_IMAGE2_RESOLUTION=1k
RUNNINGHUB_IMAGE2_TIMEOUT_MS=240000
RUNNINGHUB_IMAGE2_POLL_MS=5000

IMAGE2_LICENSE_AUDIT_SALT=
IMAGE2_QUOTA_SALT=
IMAGE2_QUOTA_REDIS_PREFIX=image2-free-quota
