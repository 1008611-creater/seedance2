{
  "name": "seedance2-weekcard",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3012",
    "cache:image2-images": "node tools/cache-image2-case-images.mjs",
    "build:image2-lite": "node tools/build-image2-lite-data.mjs",
    "prebuild": "npm run build:image2-lite",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:supabase-migration": "node tools/check-supabase-migration.mjs",
    "check:image2-license-migration": "node tools/check-image2-license-migration.mjs",
    "check:image2-wallet-migration": "node tools/check-image2-wallet-migration.mjs",
    "check:image2-workbench-migration": "node tools/check-image2-workbench-migration.mjs",
    "check:seedance-supabase-migration": "node tools/check-seedance-supabase-migration.mjs",
    "migrate:seedance-supabase": "node tools/apply-seedance-supabase-migration.mjs",
    "smoke:seedance-main-chain": "node tools/smoke-seedance-main-chain.mjs",
    "smoke:seedance-supabase": "node tools/smoke-seedance-supabase-store.mjs",
    "hyperframes:digital-human:demo": "node tools/build-digital-human-hyperframes-package.mjs --demo --inspect --render",
    "migrate:image2-workbench-supabase": "node tools/migrate-image2-workbench-to-supabase.mjs",
    "generate:image2-license-codes": "node tools/generate-image2-license-batch.mjs",
    "generate:image2-balance-packs": "node tools/generate-image2-balance-packs.mjs",
    "hash:image2-license-codes": "node tools/hash-image2-license-codes.mjs",
    "smoke:image2-supabase": "node tools/smoke-image2-supabase-assets.mjs",
    "smoke:image2-wallet": "node tools/smoke-image2-wallet-redemption.mjs",
    "smoke:image2-workbench": "node tools/smoke-image2-workbench-supabase.mjs",
    "smoke:image2-license": "node tools/smoke-image2-license-redemption.mjs",
    "pw:test": "playwright test",
    "pw:test:headed": "playwright test --headed",
    "pw:debug": "playwright test --debug",
    "pw:bit-recorded": "playwright test tests/bitbrowser-recorded-flow.spec.ts --headed",
    "pw:codegen": "playwright codegen",
    "pw:float": "powershell.exe -STA -NoProfile -ExecutionPolicy Bypass -File tools/playwright-recorder-floating.ps1",
    "pw:studio": "powershell.exe -STA -NoProfile -ExecutionPolicy Bypass -File tools/playwright-recorder-floating.ps1",
    "pw:install-app": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/install-recorder-app.ps1",
    "pw:uninstall-app": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/uninstall-recorder-app.ps1",
    "pw:report": "playwright show-report output/playwright/playwright-report",
    "bb:list": "node tools/bitbrowser-playwright.mjs list",
    "bb:pages": "node tools/bitbrowser-playwright.mjs pages",
    "bb:goto": "node tools/bitbrowser-playwright.mjs goto",
    "bb:screenshot": "node tools/bitbrowser-playwright.mjs screenshot"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
